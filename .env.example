# غيّر القيمة دي في بيئة الإنتاج — أي طلب لمسارات /admin/* لازم يبعت نفس القيمة في الهيدر X-Admin-Token
ADMIN_TOKEN=change-this-in-production

# دومينات مسموح لها تنادي الـ API من متصفح (CORS)، مفصولة بفاصلة. سيبها فاضية أثناء التطوير المحلي.
ALLOWED_ORIGINS=

LOG_LEVEL=INFO

# الدومين الفعلي للموقع بعد رفعه — بيُستخدم في sitemap.xml و robots.txt
SITE_URL=https://your-domain.example.com

# كل قد إيه (بالثواني) تُعتبر الأسعار والبيانات "قديمة" وتحتاج تحديث. التحديث
# نفسه بيحصل عند الطلب (أول زيارة بعد انتهاء المدة)، مش بحلقة خلفية دايمة —
# راجع ENABLE_BACKGROUND_LOOPS تحت لو عايز الطريقة القديمة.
MARKET_UPDATE_INTERVAL_SECONDS=3600
EGX_UPDATE_INTERVAL_SECONDS=900
CBE_UPDATE_INTERVAL_SECONDS=21600
INFLATION_UPDATE_INTERVAL_SECONDS=86400

# اختياري، وللاستضافة على سيرفر دائم بس (مش Vercel أو أي سيرفرليس تاني): فعّلها
# بـ true لو عايز حلقة خلفية دايمة تحدّث البيانات كل ما تفضى المدة أعلاه، بدل
# التحديث عند الطلب. الافتراضي false.
ENABLE_BACKGROUND_LOOPS=false

# اختياري: مفتاح مجاني من oanor.com لتفعيل مؤشرات EGX70/EGX100 وقوائم الأعلى ارتفاعاً/انخفاضاً/تداولاً.
# من غيره، هيظهر مؤشر EGX30 فقط (عبر yfinance) بدون القوائم دي. راجع README.md.
OANOR_API_KEY=

# رقم الناشر بتاعك من Google AdSense — أرقام فقط من غير أي بادئة (مثال: 1234567890123456).
# لاقيه في حساب AdSense بعد التسجيل: حساب > إعدادات > معلومات الحساب.
# لحد ما تحطه، ملف /ads.txt هيفضل تعليق فاضي، وكود الإعلانات مش هيتضاف في <head>.
# راجع قسم "الربط بجوجل أدسنس" في README.md قبل ما تحط قيمة هنا.
ADSENSE_PUBLISHER_ID=

# البريد الظاهر في صفحتي "تواصل معنا" و"سياسة الخصوصية". لازم تحطه قبل النشر.
CONTACT_EMAIL=[email protected]
